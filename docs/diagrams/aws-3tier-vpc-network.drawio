<mxfile host="app.diagrams.net" modified="2026-11-17T04:30:00.000Z" agent="TeamPulse Architect" version="21.0.0">
  <diagram id="teampulse-aws-network" name="AWS 3-Tier VPC Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Edge / Public Layer -->
        <mxCell id="users" value="Employees &amp; Managers&#xa;(HTTPS / TLS 1.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Amazon S3 Static Hosting&#xa;(SvelteKit Runes + Web Components)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- AWS VPC Box -->
        <mxCell id="vpc" value="AWS VPC (10.0.0.0/16) — Multi-AZ Isolation &amp; Network ACL Boundaries" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="820" height="740" as="geometry" />
        </mxCell>

        <!-- Tier 1: Public Subnet -->
        <mxCell id="pub-subnet" value="Tier 1: Public Subnets (10.0.1.0/24, 10.0.2.0/24) — Internet Gateway &amp; NACL" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;startSize=25;" vertex="1" parent="vpc">
          <mxGeometry x="30" y="50" width="760" height="120" as="geometry" />
        </mxCell>
        <mxCell id="alb" value="Application Load Balancer (ALB)&#xa;SG-ALB: Inbound 443 (HTTPS) | Outbound to SG-ECS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="pub-subnet">
          <mxGeometry x="40" y="40" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nat" value="NAT Gateway&#xa;(Outbound Patch/Package Access)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pub-subnet">
          <mxGeometry x="480" y="40" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Tier 2: Private App Subnet -->
        <mxCell id="app-subnet" value="Tier 2: Private Application Subnets (10.0.11.0/24, 10.0.12.0/24) — SG-ECS (Inbound Only from SG-ALB)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=25;" vertex="1" parent="vpc">
          <mxGeometry x="30" y="200" width="760" height="260" as="geometry" />
        </mxCell>
        <mxCell id="ecs" value="Amazon ECS Cluster (Fargate + Auto Scaling)&#xa;1. Identity Service   2. Habit Service   3. Challenge Service   4. Event Tracking Service&#xa;5. Insight Service   6. Recommendation Service   7. Notification Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="app-subnet">
          <mxGeometry x="30" y="45" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="eb" value="AWS EventBridge Custom Bus&#xa;(ActivityLogged / Milestone Events)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="app-subnet">
          <mxGeometry x="30" y="160" width="320" height="75" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="AWS Lambda Workers&#xa;(Streak Calculator, Badge Rules &amp; Team Aggregator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="app-subnet">
          <mxGeometry x="390" y="160" width="340" height="75" as="geometry" />
        </mxCell>

        <!-- Tier 3: Private Data Subnet -->
        <mxCell id="data-subnet" value="Tier 3: Private Data Subnets (10.0.21.0/24, 10.0.22.0/24) — Strict Data NACL (No Internet Route)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;startSize=25;" vertex="1" parent="vpc">
          <mxGeometry x="30" y="490" width="760" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rds" value="Amazon RDS (PostgreSQL Multi-AZ)&#xa;SG-RDS: Port 5432 from SG-ECS/Lambda&#xa;(Users, Habits, Challenges, Raw Logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1" vertex="1" parent="data-subnet">
          <mxGeometry x="30" y="40" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ddb" value="Amazon DynamoDB (via VPC Gateway Endpoint)&#xa;(Anonymized Manager Team Trends,&#xa;Timing Recommendations &amp; Notifications)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1" vertex="1" parent="data-subnet">
          <mxGeometry x="400" y="40" width="330" height="70" as="geometry" />
        </mxCell>

        <!-- Security & Governance Bar -->
        <mxCell id="sec-bar" value="Cross-Cutting AWS Governance: Amazon ECR (Private Images) | AWS Secrets Manager (DB &amp; JWT Secrets) | IAM Least-Privilege Task Roles | Amazon CloudWatch (Logs, Metrics &amp; Alarms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontStyle=1" vertex="1" parent="vpc">
          <mxGeometry x="30" y="640" width="760" height="70" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" edge="1" parent="1" source="users" target="s3" />
        <mxCell id="e2" edge="1" parent="1" source="users" target="alb" />
        <mxCell id="e3" edge="1" parent="vpc" source="alb" target="ecs" />
        <mxCell id="e4" edge="1" parent="vpc" source="ecs" target="eb" />
        <mxCell id="e5" edge="1" parent="vpc" source="eb" target="lambda" />
        <mxCell id="e6" edge="1" parent="vpc" source="ecs" target="rds" />
        <mxCell id="e7" edge="1" parent="vpc" source="lambda" target="ddb" />
        <mxCell id="e8" edge="1" parent="vpc" source="ecs" target="ddb" />
      </root>
    </mxGraphModel>
  </diagram>
